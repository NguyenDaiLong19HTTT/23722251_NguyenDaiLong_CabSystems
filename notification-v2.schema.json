  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cab:notification:2",
  "$ref": "#/$defs/NotificationDomainEvent",
  "$defs": {
    "NotificationDomainEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "eventId",
        "source",
        "eventType",
