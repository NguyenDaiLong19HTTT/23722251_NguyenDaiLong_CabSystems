      "properties": {
        "schemaVersion": {
          "type": "integer",
          "enum": [
            2
          ],
          "description": "Phiên bản message, độc lập với version tài liệu OpenAPI"
        },
        "eventId": {
          "$ref": "#/$defs/EventId"
        },
        "source": {
          "type": "string",
          "enum": [
            "BOOKING_SERVICE",
            "TRIP_SERVICE",
            "PAYMENT_SERVICE",
            "DRIVER_SERVICE"
          ],
          "description": "Nguồn nghiệp vụ của các sự kiện trong phiên bản này.\nKhông dùng riêng giá trị này để xác thực nguồn.\n"
        },
        "eventType": {
          "$ref": "#/$defs/NotificationEventType"
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time",
          "description": "Thời điểm phát sinh sự kiện tại MS nguồn.\nGiữ nguyên khi publish hoặc consume lại.\n"
        },
        "referenceType": {
          "$ref": "#/$defs/ReferenceType"
        },
        "referenceId": {
          "$ref": "#/$defs/Identifier"
        },
        "recipientAccountIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "description": "Account ID, không phải Customer ID hoặc Driver ID.\nDo nguồn nghiệp vụ có thẩm quyền xác định theo eventType.\nNotification Service không nhận người nhận do client tự chọn.\n"
        },
        "snapshot": {
          "$ref": "#/$defs/EventSnapshot"
        },
        "correlationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "aggregateType": {
          "type": "string",
          "enum": [
            "BOOKING",
            "TRIP_REQUEST",
            "TRIP",
            "PAYMENT",
            "DRIVER_APPLICATION"
          ]
        },
        "aggregateId": {
          "$ref": "#/$defs/Identifier"
        },
        "aggregateVersion": {
          "type": "integer",
          "minimum": 1,
          "description": "Phiên bản aggregate tại commit tạo sự kiện, giữ nguyên khi replay; không so sánh version giữa hai aggregate/MS."
        }
      },
      "description": "Hợp đồng message qua RabbitMQ, không phải request body của API công khai.\nNội dung được đóng băng tại nguồn và giữ nguyên khi gửi lại.\nSnapshot tối thiểu giúp xử lý sự kiện đến chậm mà không cần đọc\ntrực tiếp cơ sở dữ liệu của MS nguồn.\n",
      "oneOf": [
        {
          "properties": {
            "source": {
              "type": "string",
              "enum": [
                "BOOKING_SERVICE"
              ]
            },
            "eventType": {
              "type": "string",
              "enum": [
                "BOOKING_RECEIVED"
