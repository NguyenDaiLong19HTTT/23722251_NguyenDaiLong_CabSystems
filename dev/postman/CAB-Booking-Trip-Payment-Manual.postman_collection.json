        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer PASTE_ASSIGNED_DRIVER_TOKEN"
          },
          {
            "key": "Idempotency-Key",
            "value": "PASTE_UNIQUE_CASH_KEY"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"expectedVersion\":1}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "http://127.0.0.1:33201/v1/payments/PASTE_PAYMENT_UUID/confirm-cash"
      }
    },
    {
      "name": "21 CUSTOMER or DRIVER - Closure release progress",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer PASTE_CUSTOMER_OR_DRIVER_TOKEN"
          }
        ],
        "url": "http://127.0.0.1:33201/v1/trips/PASTE_TRIP_UUID/closure"
      }
    },
    {
      "name": "22 CUSTOMER or DRIVER - Own Notifications",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer PASTE_CUSTOMER_OR_DRIVER_TOKEN"
          }
        ],
        "url": "http://127.0.0.1:33201/v1/notifications?limit=20"
      }
    },
    {
      "name": "23 DRIVER - Report incident (alternate path; version from GET)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer PASTE_ASSIGNED_DRIVER_TOKEN"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"expectedVersion\":1,\"issueType\":\"VEHICLE_BREAKDOWN\",\"description\":\"Demo vehicle issue\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "http://127.0.0.1:33201/v1/trips/PASTE_OTHER_ACTIVE_TRIP_UUID/incidents"
      }
    },
    {
      "name": "24 CUSTOMER - Simulate DEMO_TRANSFER FAILED (alternate Trip)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer PASTE_CUSTOMER_TOKEN"
          },
          {
            "key": "Idempotency-Key",
            "value": "PASTE_UNIQUE_RESULT_KEY"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"attemptId\":\"PASTE_CURRENT_ATTEMPT_UUID\",\"expectedVersion\":1,\"expectedAmount\":6625,\"currency\":\"VND\",\"outcome\":\"FAILED\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "http://127.0.0.1:33201/v1/payments/PASTE_PAYMENT_UUID/demo-result"
      }
    },
    {
      "name": "25 CUSTOMER - Retry FAILED DEMO_TRANSFER",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer PASTE_CUSTOMER_TOKEN"
          },
          {
            "key": "Idempotency-Key",
            "value": "PASTE_UNIQUE_RETRY_KEY"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"expectedVersion\":2,\"paymentMethod\":\"DEMO_TRANSFER\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "http://127.0.0.1:33201/v1/payments/PASTE_PAYMENT_UUID/retry"
      }
    },
    {
      "name": "26 CUSTOMER - Legacy paid-before-cancel review (existing Payment only)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer PASTE_CUSTOMER_TOKEN"
          },
          {
            "key": "Content-Type",
