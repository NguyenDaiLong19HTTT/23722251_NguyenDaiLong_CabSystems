            "key": "Authorization",
            "value": "Bearer PASTE_CUSTOMER_TOKEN"
          }
        ],
        "url": "http://127.0.0.1:33201/v1/payments/PASTE_PAYMENT_UUID"
      }
    },
    {
      "name": "28 CUSTOMER - Cancel unassigned Booking",
