        "body": {
          "mode": "raw",
          "raw": "{\"attemptId\":\"PASTE_ATTEMPT_UUID\",\"expectedVersion\":1,\"expectedAmount\":6625,\"currency\":\"VND\",\"outcome\":\"SUCCESS\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "http://127.0.0.1:33201/v1/payments/PASTE_PAYMENT_UUID/demo-result"
      }
    },
    {
