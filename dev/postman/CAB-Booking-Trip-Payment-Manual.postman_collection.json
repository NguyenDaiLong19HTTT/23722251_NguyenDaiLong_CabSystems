              "language": "json"
            }
          }
        },
        "url": "http://127.0.0.1:33201/v1/bookings/PASTE_BOOKING_UUID/cancel"
      }
    },
    {
      "name": "29 OPERATOR - Nearby Drivers (default 1 km)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer PASTE_OPERATOR_TOKEN"
          }
        ],
        "url": "http://127.0.0.1:33201/v1/drivers/nearby?latitude=10.78&longitude=106.7"
      }
    }
  ]
}
