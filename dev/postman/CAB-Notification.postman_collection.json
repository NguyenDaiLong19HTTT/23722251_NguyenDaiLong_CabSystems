{
  "info": {"name":"CAB Notification — Driver review demo","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
  "item": [
    {"name":"1 Approved Driver lists notifications — 200","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{newDriverToken}}"}],"url":"{{baseUrl}}/v1/notifications?limit=20"},"event":[{"listen":"test","script":{"exec":["pm.test('Own inbox',()=>pm.response.to.have.status(200));","if(pm.response.code===200){const d=pm.response.json();const item=d.items.find(x=>x.eventType==='DRIVER_APPLICATION_APPROVED'&&x.referenceId===pm.environment.get('newDriverApplicationId'));pm.test('Approved event delivered',()=>pm.expect(item).to.exist);if(item)pm.environment.set('approvedNotificationId',item.notificationId);}"]}}]},
    {"name":"2 Approved Driver marks read — 200","request":{"method":"PATCH","header":[{"key":"Authorization","value":"Bearer {{newDriverToken}}"}],"url":"{{baseUrl}}/v1/notifications/{{approvedNotificationId}}/read"},"event":[{"listen":"test","script":{"exec":["pm.test('Marked read',()=>pm.response.to.have.status(200));","if(pm.response.code===200){const d=pm.response.json();pm.test('Read timestamp set',()=>{pm.expect(d.isRead).to.eql(true);pm.expect(d.readAt).to.be.a('string');});pm.environment.set('approvedReadAt',d.readAt);}"]}}]},
    {"name":"3 Repeated read keeps first timestamp — 200","request":{"method":"PATCH","header":[{"key":"Authorization","value":"Bearer {{newDriverToken}}"}],"url":"{{baseUrl}}/v1/notifications/{{approvedNotificationId}}/read"},"event":[{"listen":"test","script":{"exec":["pm.test('Repeat read',()=>pm.response.to.have.status(200));","if(pm.response.code===200)pm.test('First readAt retained',()=>pm.expect(pm.response.json().readAt).to.eql(pm.environment.get('approvedReadAt')));"]}}]},
    {"name":"4 Rejected Driver lists notifications — 200","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{rejectedDriverToken}}"}],"url":"{{baseUrl}}/v1/notifications?limit=20"},"event":[{"listen":"test","script":{"exec":["pm.test('Rejected Driver inbox',()=>pm.response.to.have.status(200));","if(pm.response.code===200){const item=pm.response.json().items.find(x=>x.eventType==='DRIVER_APPLICATION_REJECTED'&&x.referenceId===pm.environment.get('rejectedApplicationId'));pm.test('Rejection reason delivered',()=>{pm.expect(item).to.exist;pm.expect(item.message).to.include(pm.environment.get('rejectionReason'));});if(item)pm.environment.set('rejectedNotificationId',item.notificationId);}"]}}]},
    {"name":"5 Other Driver cannot read recipient notification — 404","request":{"method":"PATCH","header":[{"key":"Authorization","value":"Bearer {{rejectedDriverToken}}"}],"url":"{{baseUrl}}/v1/notifications/{{approvedNotificationId}}/read"},"event":[{"listen":"test","script":{"exec":["pm.test('Other owner hidden',()=>pm.response.to.have.status(404));","if(pm.response.code===404)pm.test('Correct error',()=>pm.expect(pm.response.json().errorCode).to.eql('NOTIFICATION_NOT_FOUND'));"]}}]},
    {"name":"6 Page one — 200","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{newDriverToken}}"}],"url":"{{baseUrl}}/v1/notifications?limit=1"},"event":[{"listen":"test","script":{"exec":["pm.test('Page one',()=>pm.response.to.have.status(200));","if(pm.response.code===200){const d=pm.response.json();pm.test('One item and cursor',()=>{pm.expect(d.items).to.have.length(1);pm.expect(d.nextCursor).to.be.a('string');});pm.environment.set('notificationNextCursor',d.nextCursor);pm.environment.set('notificationFirstPageId',d.items[0].notificationId);}"]}}]},
    {"name":"7 Page two — 200","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{newDriverToken}}"}],"url":"{{baseUrl}}/v1/notifications?limit=1&cursor={{notificationNextCursor}}"},"event":[{"listen":"test","script":{"exec":["pm.test('Page two',()=>pm.response.to.have.status(200));","if(pm.response.code===200)pm.test('Stable next item',()=>pm.expect(pm.response.json().items[0].notificationId).not.to.eql(pm.environment.get('notificationFirstPageId')));"]}}]},
    {"name":"8 Unauthenticated inbox — 401","request":{"method":"GET","url":"{{baseUrl}}/v1/notifications"},"event":[{"listen":"test","script":{"exec":["pm.test('Bearer required',()=>pm.response.to.have.status(401));"]}}]}
  ]
}
