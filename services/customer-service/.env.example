# Placeholders only; not loaded automatically. main requires all values.
CUSTOMER_SERVICE_GRPC_BIND=<private-interface:port>
CUSTOMER_SERVICE_CA_FILE=<workload-ca-path>
CUSTOMER_SERVICE_CERT_FILE=<workload-certificate-path>
CUSTOMER_SERVICE_KEY_FILE=<workload-private-key-path>
# Application runtime only. Migration URL belongs to a separate deploy job, never main.
CAB_CUSTOMER_RUNTIME_URL=<customer-runtime-postgresql-url>
# Deploy-job example, not loaded by the application:
CAB_CUSTOMER_MIGRATION_URL=<customer-migration-postgresql-url>
