# Placeholders only; not loaded automatically. main requires all values.
IDENTITY_SERVICE_GRPC_BIND=<private-interface:port>
IDENTITY_SERVICE_CA_FILE=<workload-ca-path>
IDENTITY_SERVICE_CERT_FILE=<workload-certificate-path>
IDENTITY_SERVICE_KEY_FILE=<workload-private-key-path>
# Application runtime only. Migration URL belongs to a separate deploy job, never main.
CAB_IDENTITY_RUNTIME_URL=<identity-runtime-postgresql-url>
# Deploy-job example, not loaded by the application:
CAB_IDENTITY_MIGRATION_URL=<identity-migration-postgresql-url>
