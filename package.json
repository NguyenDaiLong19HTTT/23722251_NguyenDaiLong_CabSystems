{
  "name": "cab-foundation",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11.17.0 <12"
  },
  "workspaces": [
    "packages/grpc-transport",
    "packages/phone-number",
    "services/api-gateway",
    "services/identity-service",
    "services/customer-service",
    "services/driver-service",
    "services/notification-service",
    "services/payment-service",
    "services/booking-service",
    "services/trip-service",
    "services/rating-service"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:built": "node test/built-context.mjs",
    "test:transport": "vitest run test/transport.spec.ts test/payload.spec.ts",
    "probe:postgres": "node experiments/prisma-postgres/run.mjs",
    "probe:generate": "prisma generate --config services/identity-service/src/infrastructure/prisma-probe/prisma.config.ts && prisma generate --config services/customer-service/src/infrastructure/prisma-probe/prisma.config.ts",
    "typecheck:probe": "tsc --noEmit -p tsconfig.probe.json",
    "db:generate": "prisma generate --config services/identity-service/src/infrastructure/prisma/prisma.config.ts && prisma generate --config services/customer-service/src/infrastructure/prisma/prisma.config.ts && prisma generate --config services/driver-service/src/infrastructure/prisma/prisma.config.ts",
    "db:deploy:identity": "prisma migrate deploy --config services/identity-service/src/infrastructure/prisma/prisma.config.ts",
    "db:deploy:customer": "prisma migrate deploy --config services/customer-service/src/infrastructure/prisma/prisma.config.ts",
    "db:verify": "node experiments/production-postgres/run.mjs",
    "typecheck:db": "tsc --noEmit -p tsconfig.production-db.json",
    "dev:setup": "node dev/setup.mjs",
    "dev:notification:setup": "node dev/setup-notification.mjs",
    "dev:notification:up": "node dev/notification-up.mjs",
    "dev:notification:stop": "node dev/run.mjs stop-notification",
    "dev:diagnose": "node dev/diagnose-start.mjs",
    "dev:certs:renew": "node dev/renew-certificates.mjs",
    "dev:up": "node dev/run.mjs up",
    "dev:migrate": "node dev/run.mjs migrate",
    "dev:start": "node dev/run.mjs start",
    "dev:start:notification": "node dev/run.mjs start-notification",
    "dev:seed:driver": "node dev/run.mjs seed-driver",
    "dev:seed:operator": "node dev/run.mjs seed-operator",
    "dev:otp": "node dev/run.mjs otp",
    "dev:stop": "node dev/run.mjs stop"
  },
  "devDependencies": {
    "@swc/core": "1.16.12",
    "@types/amqplib": "0.10.8",
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "pg": "8.23.1",
    "prisma": "7.10.0",
    "supertest": "7.3.0",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.3"
  }
}
